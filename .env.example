# ============================================================================
# Copy this file to ".env" and fill in the values.
#     cp .env.example .env
# NEVER commit your real .env to git (it contains passwords).
#
# These are just the STARTING values. Once the container is running you can
# change ANY of them from the web dashboard's "⚙ Settings" panel -- your changes
# are saved to /data/state/settings.json and quietly override what's here.
# ============================================================================

# ---- Site title (shown big on the dashboard, browser tab + link preview) ----
# Two lines. Leave SITE_TITLE_LINE2 blank for a single-line title.
SITE_TITLE_LINE1=MY TIME
SITE_TITLE_LINE2=LAPSE

# ---- Arlo account (use a DEDICATED sub-account, NOT your main login) --------
ARLO_USERNAME=dedicated-arlo@example.com
ARLO_PASSWORD=your-arlo-password
# The camera's name EXACTLY as it appears in the Arlo app (case/spaces matter):
CAMERA_NAME=Bike Park

# ---- Gmail used for BOTH reading the 2FA code (IMAP) and sending mail (SMTP) -
# Create a Gmail "App Password" (16 characters) and use it for IMAP_PASSWORD AND
# SMTP_PASSWORD. Make sure IMAP is turned on in Gmail settings.
IMAP_HOST=imap.gmail.com
IMAP_USERNAME=dedicated-gmail@gmail.com
IMAP_PASSWORD=your-16-char-app-password

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=dedicated-gmail@gmail.com
SMTP_PASSWORD=your-16-char-app-password

# Where alerts + the daily digest are SENT (can be your normal email):
ALERT_EMAIL=you@example.com
# Optional "From" address (defaults to SMTP_USERNAME if left blank):
# FROM_EMAIL=dedicated-gmail@gmail.com

# ---- Capture behaviour ------------------------------------------------------
CAPTURE_INTERVAL_MIN=15
SNAPSHOT_TIMEOUT_SEC=60
CAPTURE_RETRIES=3

# ---- Capture window ---------------------------------------------------------
# By default the window follows the sun: sunrise+buffer .. sunset-buffer.
# Set LATITUDE/LONGITUDE to YOUR location (default placeholder = Boston, MA).
LATITUDE=42.360
LONGITUDE=-71.059
DAYLIGHT_BUFFER_MIN=30
TZ=America/New_York
# OPTIONAL fixed clock window. Set BOTH to use exact times instead of the sun;
# leave BLANK (the default) to follow sunrise/sunset.
CAPTURE_START=
CAPTURE_END=

# ---- Alerts -----------------------------------------------------------------
BATTERY_ALERT_PCT=20
CONSECUTIVE_FAIL_ALERT=3
ALERT_COOLDOWN_HOURS=6
# "sunset" sends the digest at sunset each day; or set a fixed time like "20:30":
DAILY_DIGEST_TIME=sunset

# ---- Session / connection ---------------------------------------------------
RECONNECT_EVERY_MIN=90
LOG_LEVEL=INFO

# ---- Local web dashboard ----------------------------------------------------
# The built-in dashboard (battery, signal, photo counts + a Pause/Resume button)
# is published on this port of your UnRaid host. Open http://<unraid-host>:8080
# Change it only if 8080 is already used by another container.
WEB_PORT=8080

# ---- UnRaid storage path (the HOST side of the /data mount) -----------------
# Change this to a dedicated share you can browse over SMB from your Mac:
DATA_PATH=/mnt/user/appdata/arlo-timelapse
